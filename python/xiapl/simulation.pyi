# Both entry points release the GIL for the duration of the C++ call via a
# py::gil_scoped_release scoped INSIDE the lambda body (binding/core_simulation.cpp,
# not a py::call_guard<gil_scoped_release> -- see the comment there for why);
# no effect on the Python-visible type signature either way.
def calculate_equity(
    hole_masks: Sequence[int],
    board_mask: int,
    options: SimulationOptions,
    *,
    game: GameType = ...,
) -> EquityResult: ...

# `mode` is positional-or-keyword at the binding site (no py::kw_only()
# marker precedes it, unlike `game` above) -- transcribed as such.
def calculate_range_equity(
    hero_range: Range,
    villain_range: Range,
    board_mask: int,
    options: SimulationOptions,
    mode: RangeEquityMode = ...,
) -> RangeEquityResult: ...
