"""Type stub for xiapl.simulation (xiapl._xiapl.simulation): equity simulation +
GameType (the enum shared by xiapl.eval and xiapl.range; see
binding/core_simulation.cpp's register_simulation_gametype for why it lives
here).

Hand-written against the live binding (binding/core_simulation.cpp) and
verified with mypy.stubtest.
"""

from collections.abc import Sequence
from typing import Any

from xiapl.range import Range

class GameType(metaclass=type):
    Holdem: GameType
    Plo: GameType
    def __init__(self, value: int) -> None: ...
    def __eq__(self, other: object) -> bool: ...
    def __ne__(self, other: object) -> bool: ...
    def __int__(self) -> int: ...
    def __index__(self) -> int: ...
    def __repr__(self) -> str: ...
    def __str__(self) -> str: ...
    @property
    def name(self) -> str: ...
    @property
    def value(self) -> int: ...
    __members__: dict[str, GameType]

