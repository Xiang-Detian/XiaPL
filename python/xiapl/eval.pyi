register_eval_module) and verified with mypy.stubtest.
"""

from collections.abc import Sequence
from typing import Any

from xiapl.card import Card
from xiapl.simulation import GameType

class HandCategory(metaclass=type):
    HighCard: HandCategory
    OnePair: HandCategory
    TwoPair: HandCategory
    ThreeOfAKind: HandCategory
    Straight: HandCategory
    Flush: HandCategory
    FullHouse: HandCategory
    FourOfAKind: HandCategory
    StraightFlush: HandCategory
    def __init__(self, value: int) -> None: ...
    def __eq__(self, other: object) -> bool: ...
    def __ne__(self, other: object) -> bool: ...
    def __int__(self) -> int: ...
    def __index__(self) -> int: ...
    def __repr__(self) -> str: ...
    def __str__(self) -> str: ...
    @property
    def name(self) -> str: ...
    @property
    def value(self) -> int: ...
    __members__: dict[str, HandCategory]

class HandValue(metaclass=type):
    # No py::init bound: instances are only ever produced by evaluate_*/judge.
    # Runtime __init__ accepts (*args, **kwargs) and unconditionally raises
    # "No constructor defined!" -- mirrored here for stubtest; not meant to
    # be called from Python.
    def __init__(self, *args: Any, **kwargs: Any) -> None: ...
    @property
    def category(self) -> HandCategory: ...
    @property
    def kickers(self) -> list[int]: ...
    def __repr__(self) -> str: ...

def describe_hand(value: HandValue) -> str: ...
def evaluate_cards(cards: Sequence[Card]) -> HandValue: ...
def evaluate_mask(card_mask: int) -> HandValue: ...

# `game` is keyword-only at the binding site (py::kw_only()): a rule
# selector, never something a caller should positionally decode.
def evaluate_hand(
    board_mask: int, hole_mask: int, *, game: GameType = ...
) -> HandValue: ...
def judge(
    player_hole_masks: Sequence[int], board_mask: int, *, game: GameType = ...
) -> list[int]: ...
